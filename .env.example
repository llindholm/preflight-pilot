# Resend: API key with permission to send from your verified domain
RESEND_API_KEY=
# Use an address on that verified domain
PILOT_FROM_EMAIL=Preflight Pilot <pilot@your-domain.com>
PILOT_TO_EMAIL=luke@tolivingfree.com
# Cloudflare Turnstile: managed widget, approved website hostnames
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Exact public origin, no trailing slash. Set separately for production/preview.
APP_ORIGIN=http://localhost:3000
